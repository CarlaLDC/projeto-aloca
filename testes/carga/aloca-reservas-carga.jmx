        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${token}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Liberar todas as tentativas juntas">
            <stringProp name="groupSize">${__P(pe03.threads,10)}</stringProp>
            <stringProp name="timeoutInMs">${__P(pe03.sync_timeout,30000)}</stringProp>
          </SyncTimer>
          <hashTree/>
          <!-- 409 é a resposta esperada para as perdedoras: ignora o status HTTP e aceita só 201 ou 409. -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="201 ou 409 (409 esperado)">
            <collectionProp name="Asserion.test_strings"><stringProp name="4">^(201|409)$</stringProp></collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">1</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="201 vencedora ou 409 com conflitos">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def codigo = prev.getResponseCode()
def corpo = prev.getResponseDataAsString()
if (codigo == '201') {
  if (!corpo.contains('"status":"APROVADA"')) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('201 sem status APROVADA') }
} else if (codigo == '409') {
  if (!corpo.contains('"conflitos"')) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('409 sem lista de conflitos') }
} else {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage('Inesperado na disputa: HTTP ' + codigo)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ============================== PE-01: pesquisa de disponibilidade ============================== -->
      <!-- Fase própria: começa depois de PE-02/PE-03 (pe01.atraso), com 50 usuários só pesquisando.
           A base já tem as reservas da campanha (vencedoras das disputas continuam APROVADA). -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="PE-01 Pesquisa de disponibilidade">
        <stringProp name="ThreadGroup.num_threads">${__P(pe01.threads,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,60)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(pe01.duracao,660)}</stringProp>
        <stringProp name="ThreadGroup.delay">${__P(pe01.atraso,0)}</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="PE-01 preparar iteração">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Usuário e dia pesquisado">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.time.LocalDate
import java.util.concurrent.ThreadLocalRandom
def k = ctx.getThreadNum()
def emails = props.get('massa.pe01')
def manifesto = props.get('massa.manifesto')
vars.put('email', emails[k % emails.size()])
// Dias com reservas da campanha: as disputas ocupam pe03DataBase + 0..(disputas-1).
int dias = Math.max(1, (manifesto.pe03Disputas ?: 1) as int)
vars.put('dataPesquisa', LocalDate.parse(manifesto.pe03DataBase).plusDays(ThreadLocalRandom.current().nextInt(dias)).toString())</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Login uma vez"/>
        <hashTree>
