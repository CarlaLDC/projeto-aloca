<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aloca · PE-02 (criação/alteração/cancelamento com massa exclusiva),
  PE-03 (disputas simultâneas por sala, professor e material sob volume) e
  PE-01 (pesquisa de disponibilidade com 50 usuários, fase própria depois de PE-02/PE-03,
  com a base já carregada pelas reservas da campanha).
  Executar com testes/carga/executar-carga.sh, que prepara a massa isolada,
  sobe API + PostgreSQL e preserva JTL, dashboard, log e análise.
  Propriedades (-J): host, port, massa, senha, rampup, duracao,
  pe02.threads, pe02.pensar_min, pe02.pensar_var, pe03.threads, pe03.disputas,
  pe03.atraso, pe03.pensar, pe03.sync_timeout,
  pe01.threads, pe01.duracao, pe01.atraso, pe01.pensar_min, pe01.pensar_var, pe01.professores.
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Aloca - carga de reservas e concorrência">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="Padrões HTTP">
        <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
        <stringProp name="HTTPSampler.port">${__P(port,8080)}</stringProp>
        <stringProp name="HTTPSampler.protocol">http</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
      </ConfigTestElement>
      <hashTree/>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <!-- ============================== setUp: carrega a massa isolada ============================== -->
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="SETUP carregar massa">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="SETUP massa">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Ler CSVs da massa">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def dir = props.getProperty('massa', 'massa')
def ler = { String nome -&gt;
  def linhas = new File(dir, nome).readLines('UTF-8').findAll { it.trim() }
  def cab = linhas[0].split(',')
  linhas.drop(1).collect { l -&gt;
    def v = l.split(',', -1)
    def m = [:]
    cab.eachWithIndex { c, i -&gt; m[c] = v[i] }
    m
  }
}
def manifesto = new groovy.json.JsonSlurper().parse(new File(dir, 'manifesto.json'))
props.put('massa.pe02', ler('pe02.csv'))
props.put('massa.pe03.usuarios', ler('pe03_usuarios.csv'))
props.put('massa.pe03.disputas', ler('pe03_disputas.csv'))
props.put('massa.manifesto', manifesto)
// PE-01 reaproveita os mesmos 50 Solicitantes sintéticos (PE-02 + PE-03): só leitura.
props.put('massa.pe01', props.get('massa.pe02').collect { it.email } + props.get('massa.pe03.usuarios').collect { it.email })
int t2 = props.getProperty('pe02.threads', '40') as int
int t3 = props.getProperty('pe03.threads', '10') as int
int d3 = props.getProperty('pe03.disputas', '150') as int
if (props.get('massa.pe02').size() &lt; t2 || props.get('massa.pe03.usuarios').size() &lt; t3
    || props.get('massa.pe03.disputas').size() &lt; d3) {
  throw new IllegalStateException('Massa menor que threads/disputas configuradas: dados seriam compartilhados.')
}
int t1 = props.getProperty('pe01.threads', '50') as int
if (t1 &gt; 0 &amp;&amp; props.get('massa.pe01').isEmpty()) {
  throw new IllegalStateException('PE-01 sem usuários na massa.')
}
log.info("Massa ${manifesto.prefixo} carregada: PE-01=${t1} PE-02=${t2} PE-03=${t3}x${d3}")</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ============================== PE-02: ciclo com massa exclusiva ============================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="PE-02 Ciclo de reserva">
        <stringProp name="ThreadGroup.num_threads">${__P(pe02.threads,40)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,60)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duracao,660)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="PE-02 preparar iteração">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Dados exclusivos da thread">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import java.time.LocalDate
def k = ctx.getThreadNum()
def m = props.get('massa.pe02')[k]
def manifesto = props.get('massa.manifesto')
int it = (vars.get('iter') ?: '0') as int
vars.put('iter', String.valueOf(it + 1))
// Uma data por iteração: cada thread usa só a sua sala/professor/material.
def data = LocalDate.parse(manifesto.pe02DataBase).plusDays(it).toString()
def corpo = { String inicio, String fim -&gt; JsonOutput.toJson([
  atividade: "${manifesto.prefixo} PE02 T${k} I${it}".toString(), data: data, inicio: inicio, fim: fim,
  espacoId: m.salaId as long, professorId: m.professorId as long, materialIds: [m.materialId as long]]) }
vars.put('email', m.email)
vars.put('atividade', "${manifesto.prefixo} PE02 T${k} I${it}".toString())
vars.put('corpoCriar', corpo('08:00', '09:00'))
vars.put('corpoAlterar', corpo('10:00', '11:30'))
vars.put('codigo', 'NAO_ENCONTRADO')</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
