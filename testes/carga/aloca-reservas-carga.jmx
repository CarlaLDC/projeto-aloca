      <!-- ============================== PE-03: disputas simultâneas ============================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="PE-03 Disputa">
        <stringProp name="ThreadGroup.num_threads">${__P(pe03.threads,10)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">5</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duracao,660)}</stringProp>
        <stringProp name="ThreadGroup.delay">${__P(pe03.atraso,60)}</stringProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">${__P(pe03.disputas,150)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="PE-03 intervalo entre disputas">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">${__P(pe03.pensar,2000)}</stringProp>
        </TestAction>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Alvo da disputa">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import java.time.LocalDate
import java.time.LocalTime
def k = ctx.getThreadNum()
def u = props.get('massa.pe03.usuarios')[k]
def manifesto = props.get('massa.manifesto')
int d = (vars.get('iterDisputa') ?: '0') as int
vars.put('iterDisputa', String.valueOf(d + 1))
def alvo = props.get('massa.pe03.disputas')[d]
def tipo = alvo.tipo
def data = LocalDate.parse(manifesto.pe03DataBase).plusDays(d).toString()
// Horários parcialmente sobrepostos (deslocamentos de 0/10/20 min, 60 min de duração).
def inicio = LocalTime.of(14, 0).plusMinutes((k % 3) * 10)
def fim = inicio.plusMinutes(60)
def atividade = "${manifesto.prefixo} PE03 D${d} T${k}".toString()
vars.put('email', u.email)
vars.put('disputa', String.valueOf(d))
vars.put('tipoDisputa', tipo)
vars.put('alvoId', alvo.alvoId)
vars.put('atividade', atividade)
vars.put('corpoDisputa', JsonOutput.toJson([
  atividade: atividade, data: data, inicio: inicio.toString(), fim: fim.toString(),
  espacoId: (tipo == 'SALA' ? alvo.alvoId : u.salaPropriaId) as long,
  professorId: tipo == 'PROFESSOR' ? (alvo.alvoId as long) : null,
  materialIds: tipo == 'MATERIAL' ? [alvo.alvoId as long] : []]))</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Login uma vez"/>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PE-03 Login">
            <stringProp name="HTTPSampler.path">/api/auth/login</stringProp>
